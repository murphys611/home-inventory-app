{
  "expo": {
    "name": "Home Inventory",
    "slug": "HomeInventory",
    "scheme": "homeinventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Home-Inventory-App-Icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.murphys611.HomeInventory",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Home-Inventory-App-Icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.murphys611.HomeInventory",
      "allowBackup": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "08ee532e-07ce-4c3f-aea1-7ba9c0e86be5"
      }
    },
    "owner": "murphys611",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/08ee532e-07ce-4c3f-aea1-7ba9c0e86be5"
    },
    "plugins": [
      "@sentry/react-native",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "murphys611"
        }
      ]
    ]
  }
}
